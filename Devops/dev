#!/usr/bin/env sh
set -eu

DEVOPS_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ENV_FILE="$DEVOPS_DIR/.env"
COMPOSE_FILE="$DEVOPS_DIR/compose.yaml"
INIT_IMAGE="${SINDICOPRO_INIT_IMAGE:-alpine:3.22}"

usage() {
    cat <<'EOF'
Uso: ./Devops/dev <comando> [servicos]

Ambiente:
  init              cria Devops/.env usando um container descartavel
  config            valida a configuracao do Docker Compose
  build [servicos]  constroi todas as imagens ou somente as informadas
  up [servicos]     inicia tudo ou somente os servicos informados
  down              encerra tudo sem apagar volumes
  restart [servicos]
  ps
  logs [servicos]

Aplicacoes independentes:
  frontend-up       inicia somente o frontend
  frontend-down     encerra somente o frontend
  frontend-shell    abre um shell no frontend
  backend-up        inicia backend, banco, Mailpit, worker e scheduler
  backend-down      encerra os servicos do backend
  backend-shell     abre um shell no backend

Banco e qualidade:
  database-shell    abre o cliente PostgreSQL
  migrate
  seed
  test-frontend
  test-backend
  quality
EOF
}

require_docker() {
    if ! command -v docker >/dev/null 2>&1; then
        echo "SindicoPro: Docker nao encontrado." >&2
        exit 1
    fi

    if ! docker compose version >/dev/null 2>&1; then
        echo "SindicoPro: Docker Compose v2 nao encontrado." >&2
        exit 1
    fi
}

init_env() {
    require_docker

    docker run --rm \
        --user "$(id -u):$(id -g)" \
        --volume "$DEVOPS_DIR:/work:z" \
        "$INIT_IMAGE" \
        sh -eu -c '
            if [ ! -f /work/.env ]; then
                cp /work/.env.example /work/.env
            fi

            if grep -q "^APP_KEY=$" /work/.env; then
                app_key=$(head -c 32 /dev/urandom | base64)
                sed -i "s|^APP_KEY=.*|APP_KEY=base64:$app_key|" /work/.env
            fi

            chmod 600 /work/.env
        '

    echo "SindicoPro: Devops/.env pronto para desenvolvimento local."
}

ensure_env() {
    if [ ! -f "$ENV_FILE" ] || grep -q '^APP_KEY=$' "$ENV_FILE"; then
        echo "SindicoPro: preparando Devops/.env automaticamente..." >&2
        init_env
    fi
}

compose() {
    docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

ensure_test_database() {
    compose exec -T database sh -eu -c '
        test_database="${POSTGRES_DB}_test"
        exists=$(psql -U "$POSTGRES_USER" -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = '\''$test_database'\''")

        if [ "$exists" != "1" ]; then
            createdb -U "$POSTGRES_USER" "$test_database"
        fi
    '
}

command_name="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command_name" in
    help|-h|--help)
        usage
        ;;
    init)
        init_env
        ;;
    config)
        require_docker
        ensure_env
        compose config
        ;;
    build)
        require_docker
        ensure_env
        compose build "$@"
        ;;
    up)
        require_docker
        ensure_env
        compose up -d --build "$@"
        ;;
    down)
        require_docker
        ensure_env
        compose down
        ;;
    restart)
        require_docker
        ensure_env
        compose restart "$@"
        ;;
    ps)
        require_docker
        ensure_env
        compose ps
        ;;
    logs)
        require_docker
        ensure_env
        compose logs --follow --tail=150 "$@"
        ;;
    frontend-up)
        require_docker
        ensure_env
        compose up -d --build frontend
        ;;
    frontend-down)
        require_docker
        ensure_env
        compose stop frontend
        ;;
    frontend-shell)
        require_docker
        ensure_env
        compose exec --user node frontend sh
        ;;
    backend-up)
        require_docker
        ensure_env
        compose up -d --build database mailpit backend worker scheduler
        ;;
    backend-down)
        require_docker
        ensure_env
        compose stop scheduler worker backend mailpit database
        ;;
    backend-shell)
        require_docker
        ensure_env
        compose exec backend sh
        ;;
    database-shell)
        require_docker
        ensure_env
        compose exec database sh -lc 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB"'
        ;;
    migrate)
        require_docker
        ensure_env
        compose exec backend php artisan migrate
        ;;
    seed)
        require_docker
        ensure_env
        compose exec backend php artisan db:seed
        ;;
    test-frontend)
        require_docker
        ensure_env
        compose exec --user node frontend npm test
        ;;
    test-backend)
        require_docker
        ensure_env
        ensure_test_database
        compose exec -T backend sh -eu -c 'APP_ENV=testing DB_DATABASE="${TEST_DB_DATABASE:-sindicopro_test}" SESSION_DRIVER=array CACHE_STORE=array QUEUE_CONNECTION=sync vendor/bin/phpunit'
        ;;
    quality)
        require_docker
        ensure_env
        compose exec backend composer validate --strict
        compose exec backend vendor/bin/pint --test
        ensure_test_database
        compose exec -T backend sh -eu -c 'APP_ENV=testing DB_DATABASE="${TEST_DB_DATABASE:-sindicopro_test}" SESSION_DRIVER=array CACHE_STORE=array QUEUE_CONNECTION=sync vendor/bin/phpunit'
        compose exec --user node frontend npm run quality
        ;;
    *)
        echo "SindicoPro: comando desconhecido: $command_name" >&2
        usage >&2
        exit 2
        ;;
esac
