# Gerado automaticamente por `./Devops/dev init` ou `./Devops/dev up`.
# Nenhuma ferramenta alem de Docker com Compose e necessaria na maquina.
COMPOSE_PROJECT_NAME=sindicopro

PHP_VERSION=8.4
NODE_VERSION=22

BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5433
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

POSTGRES_DB=sindicopro
POSTGRES_USER=sindicopro
POSTGRES_PASSWORD=sindicopro_local

APP_KEY=
LOG_LEVEL=debug
CHOKIDAR_USEPOLLING=false
